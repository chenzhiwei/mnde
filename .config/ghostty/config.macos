auto-update-channel = tip

theme = Ubuntu
macos-titlebar-style = native
font-size = 16

# macos key remap
# ctrl alias: control
# super alias: cmd, command
# alt alias: opt, option
key-remap = ctrl=alt
key-remap = super=ctrl
key-remap = alt=super

window-decoration = auto
# macos-titlebar-style = tabs

keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+tab=unbind
keybind = shift+arrow_down=unbind
keybind = shift+arrow_left=unbind
keybind = shift+arrow_right=unbind
keybind = shift+arrow_up=unbind
keybind = shift+end=unbind
keybind = shift+home=unbind
keybind = shift+page_down=unbind
keybind = shift+page_up=unbind
keybind = super++=unbind
keybind = super+,=unbind
keybind = super+-=unbind
keybind = super+0=unbind
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+a=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+i=unbind
keybind = super+alt+shift+j=unbind
keybind = super+alt+shift+w=unbind
keybind = super+alt+w=unbind
keybind = super+arrow_down=unbind
keybind = super+arrow_left=unbind
keybind = super+arrow_right=unbind
keybind = super+arrow_up=unbind
keybind = super+backspace=unbind
keybind = super+bracket_left=unbind
keybind = super+bracket_right=unbind
keybind = super+c=unbind
keybind = super+ctrl+arrow_down=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+ctrl+equal=unbind
keybind = super+ctrl+f=unbind
keybind = super+ctrl+shift+j=unbind
keybind = super+d=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind
keybind = super+e=unbind
keybind = super+end=unbind
keybind = super+enter=unbind
keybind = super+equal=unbind
keybind = super+f=unbind
keybind = super+g=unbind
keybind = super+home=unbind
keybind = super+j=unbind
keybind = super+k=unbind
keybind = super+n=unbind
keybind = super+page_down=unbind
keybind = super+page_up=unbind
keybind = super+q=unbind
keybind = super+shift+,=unbind
keybind = super+shift+arrow_down=unbind
keybind = super+shift+arrow_up=unbind
keybind = super+shift+bracket_left=unbind
keybind = super+shift+bracket_right=unbind
keybind = super+shift+d=unbind
keybind = super+shift+enter=unbind
keybind = super+shift+f=unbind
keybind = super+shift+g=unbind
keybind = super+shift+j=unbind
keybind = super+shift+p=unbind
keybind = super+shift+t=unbind
keybind = super+shift+v=unbind
keybind = super+shift+w=unbind
keybind = super+shift+z=unbind
keybind = super+t=unbind
keybind = super+v=unbind
keybind = super+w=unbind
keybind = super+z=unbind

keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=last_tab
keybind = alt+digit_1=goto_tab:1
keybind = alt+digit_2=goto_tab:2
keybind = alt+digit_3=goto_tab:3
keybind = alt+digit_4=goto_tab:4
keybind = alt+digit_5=goto_tab:5
keybind = alt+digit_6=goto_tab:6
keybind = alt+digit_7=goto_tab:7
keybind = alt+digit_8=goto_tab:8
keybind = alt+digit_9=last_tab
keybind = alt+f4=close_window
keybind = ctrl+0=reset_font_size
keybind = ctrl+alt+arrow_down=goto_split:down
keybind = ctrl+alt+arrow_left=move_tab:-1
keybind = ctrl+alt+arrow_right=move_tab:1
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+shift+j=write_screen_file:open
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+enter=toggle_fullscreen
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl++=increase_font_size:1
keybind = ctrl+insert=copy_to_clipboard
keybind = ctrl+,=open_config
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+shift+arrow_left=previous_tab
keybind = ctrl+shift+arrow_right=next_tab
keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+shift+i=inspector:toggle
keybind = ctrl+shift+j=write_screen_file:paste
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+page_down=jump_to_prompt:1
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+q=quit
keybind = ctrl+shift+,=reload_config
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+tab=next_tab
keybind = shift+arrow_down=adjust_selection:down
keybind = shift+arrow_left=adjust_selection:left
keybind = shift+arrow_right=adjust_selection:right
keybind = shift+arrow_up=adjust_selection:up
keybind = shift+end=scroll_to_bottom
keybind = shift+f10=paste_from_selection
keybind = shift+f9=paste_from_selection
keybind = shift+home=scroll_to_top
keybind = shift+insert=paste_from_selection
keybind = shift+page_down=scroll_page_down
keybind = shift+page_up=scroll_page_up
keybind = super+ctrl+bracket_left=goto_split:previous
keybind = super+ctrl+bracket_right=goto_split:next
keybind = super+ctrl+shift+arrow_down=resize_split:down,10
keybind = super+ctrl+shift+arrow_left=resize_split:left,10
keybind = super+ctrl+shift+arrow_right=resize_split:right,10
keybind = super+ctrl+shift+arrow_up=resize_split:up,10
keybind = super+ctrl+shift+j=write_screen_file:copy
